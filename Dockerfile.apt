# Image for networks where PyPI is blocked but Debian mirrors work.
# Dependencies come from Debian packages; ChromeRAG itself is installed from this checkout.
# Baselines without a Debian package (trafilatura, markdownify, markitdown) are not included,
# so the compare UI lists only the baselines that import.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Optional extra CA bundle for a TLS-inspecting proxy: place it at infra/certs/corp-ca.pem.
COPY infra/certs/ /usr/local/share/ca-certificates/extra/
RUN set -eux; \
    for f in /usr/local/share/ca-certificates/extra/*.pem; do \
      [ -f "$f" ] && cp "$f" "${f%.pem}.crt" || true; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    update-ca-certificates; \
    apt-get install -y --no-install-recommends \
      python3 python3-pip python3-setuptools python3-wheel \
      python3-bs4 python3-lxml python3-yaml python3-numpy python3-pydantic python3-httpx \
      python3-fastapi python3-uvicorn python3-readability python3-html2text python3-extruct \
      python3-pytest; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md LICENSE.txt ./
COPY src ./src
RUN pip install --no-deps --no-build-isolation --break-system-packages .

ENV PYTHONPATH=/app
EXPOSE 8765
CMD ["python3", "-m", "uvicorn", "apps.ui.main:app", "--host", "0.0.0.0", "--port", "8765"]
